{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-comercial",
  // worker.mjs envuelve el bundle de OpenNext y suma el cron del correo semanal
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Solo se entra por comercial.mbc-latam.com, protegido por Cloudflare Access.
  // Se apagan las URL *.workers.dev para que no exista una puerta sin login.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "comercial.mbc-latam.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar-comercial",
      "database_id": "8e1e2e7b-4aef-49b5-91f5-5dd348c63ee1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Se completan al crear la aplicación en Cloudflare Zero Trust > Access.
    // Mientras estén vacías, la app no deja pasar a nadie (falla cerrada).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "APP_URL": "https://comercial.mbc-latam.com",
    // Remitente verificado en Resend. La clave va como secreto: wrangler secret put RESEND_API_KEY
    "RESUMEN_DESDE": "",
    // Piloto: si se llena, todos los correos van solo a esta dirección
    "RESUMEN_SOLO_A": ""
  },
  // Correo de los lunes a las 08:00 de Lima (13:00 UTC). Sin RESEND_API_KEY no envía.
  "triggers": { "crons": ["0 13 * * 1"] },
  "observability": { "enabled": true }
}
